---
// src/layouts/Layout.astro
interface Props {
  title?: string;
}

const { title = "Photography Portfolio" } = Astro.props;
// Get current path to highlight active page
const pathname = new URL(Astro.request.url).pathname;

// Helper function to check if link is active (handles trailing slashes)
const isActive = (path: string) => {
  if (path === '/') {
    return pathname === '/' || pathname === '';
  }
  return pathname.startsWith(path);
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <!-- Reusable Navigation Bar -->
    <header class="header-bar-wrapper">
      <div class="header-inner">
        <nav class="header-nav">
          <div class="header-nav-title">
            <a id="site-title" href="/">Emily Keane</a>
          </div>
          <div class="header-nav-items">
            <a href="/portfolio" class="nav-item">Portfolio</a>
            <a href="/contact" class="nav-item">Contact</a>
          </div>
        </nav>
      </div>
    </header>

    <!-- Page Content Slot -->
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* Global Resets & Theme */
  * {
    box-sizing: border-box;
  }
  body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #111;
    color: #fff;
    margin: 0;
    padding: 0;
  }

  /* Header & Navigation Styling */
  .header-bar-wrapper {
    background: #181818;
    border-bottom: 1px solid #2a2a2a;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
  }

  .header-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  #site-title {
    color: #fff;
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 1px;
    transition: opacity 0.2s ease;
  }

  #site-title:hover {
    opacity: 0.8;
  }

  .header-nav-items {
    display: flex;
    gap: 2rem; /* Tab space between links */
  }

  .nav-item {
    color: #aaa;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 400;
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  /* Hover State: Bolden & Highlight */
  .nav-item:hover {
    color: #fff;
    font-weight: 700;
    background-color: rgba(255, 255, 255, 0.1);
  }
</style>