---
// src/pages/portfolio.astro
import Layout from '../layouts/Layout.astro';
import { sanityClient } from '../lib/sanity';

const photos = await sanityClient.fetch(`
  *[_type in ["post", "photo"]] {
    title,
    "imageUrl": coalesce(mainImage.asset->url, image.asset->url),
    caption
  }
`);
---

<Layout title="Portfolio | Emily Keane">
  <div class="page-container">
    <h1>Full Portfolio</h1>
    <div class="grid-gallery">
      {photos && photos.length > 0 ? (
        photos.map((photo: any) => (
          <div class="grid-card">
            {photo.imageUrl && <img src={photo.imageUrl} alt={photo.title || 'Portfolio Image'} loading="lazy" />}
            <div class="card-content">
              {photo.title && <h3>{photo.title}</h3>}
              {photo.caption && <p>{photo.caption}</p>}
            </div>
          </div>
        ))
      ) : (
        <p>No photos published yet.</p>
      )}
    </div>
  </div>
</Layout>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }
  h1 {
    font-weight: 300;
    letter-spacing: 2px;
    margin-bottom: 2rem;
    text-align: center;
  }
  .grid-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .grid-card {
    background: #1e1e1e;
    border-radius: 8px;
    overflow: hidden;
  }
  .grid-card img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
  }
  .card-content {
    padding: 1rem;
  }
  .card-content h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.1rem;
  }
  .card-content p {
    margin: 0;
    color: #aaa;
    font-size: 0.9rem;
  }
</style>