---
import { sanityClient } from '../lib/sanity';

// Fetch photos from Sanity
const photos = await sanityClient.fetch(`
  *[_type in ["post", "photo"]] {
    title,
    "imageUrl": coalesce(mainImage.asset->url, image.asset->url),
    caption
  }
`);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Photography Portfolio</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        background: #111;
        color: #fff;
        margin: 0;
        padding: 2rem;
      }
      h1 {
        text-align: center;
        font-weight: 300;
        letter-spacing: 2px;
        margin-bottom: 2rem;
      }
      .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
        max-width: 1200px;
        margin: 0 auto;
      }
      .card {
        background: #1e1e1e;
        border-radius: 8px;
        overflow: hidden;
      }
      .card img {
        width: 100%;
        height: 350px;
        object-fit: cover;
        display: block;
      }
      .card-content {
        padding: 1rem;
      }
      .card-content h3 {
        margin: 0 0 0.5rem 0;
        font-size: 1.1rem;
      }
      .card-content p {
        margin: 0;
        color: #aaa;
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <h1>PORTFOLIO</h1>
    <div class="gallery">
      {photos && photos.length > 0 ? (
        photos.map((photo: any) => (
          <div class="card">
            {photo.imageUrl && <img src={photo.imageUrl} alt={photo.title || 'Portfolio Image'} />}
            <div class="card-content">
              {photo.title && <h3>{photo.title}</h3>}
              {photo.caption && <p>{photo.caption}</p>}
            </div>
          </div>
        ))
      ) : (
        <p style="text-align: center; grid-column: 1 / -1;">No published photos found in Sanity yet!</p>
      )}
    </div>
  </body>
</html>